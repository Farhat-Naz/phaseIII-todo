# ============================================
# Backend Environment Variables for AWS EC2
# ============================================
# Copy this file to .env on your EC2 instance

# ============================================
# Database Configuration (Neon PostgreSQL)
# ============================================
DATABASE_URL=postgresql+psycopg://neondb_owner:YOUR_PASSWORD@YOUR_HOST.neon.tech/neondb?sslmode=require

# ============================================
# JWT Authentication
# ============================================
SECRET_KEY=b105763e0336368cc580d447338bbbc78f38c3faa24451d561398ca0983e9b64
REFRESH_TOKEN_SECRET=b45b9856c0edd136fd92777b415428a9609ac01730a0551879ff7b9893fecb88
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# CORS Settings (Update with your EC2 IP)
# ============================================
# Replace YOUR_EC2_PUBLIC_IP with actual IP (e.g., 3.110.123.45)
CORS_ORIGINS=http://YOUR_EC2_PUBLIC_IP:3000,http://YOUR_EC2_PUBLIC_IP,http://localhost:3000
CORS_ALLOW_CREDENTIALS=True
FRONTEND_URL=http://YOUR_EC2_PUBLIC_IP:3000

# ============================================
# Application Settings
# ============================================
ENV=production
DEBUG=False
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================
# Email Configuration
# ============================================
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your_sendgrid_api_key_here
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=TodoApp

# ============================================
# MCP Configuration (Optional)
# ============================================
MCP_TRANSPORT=stdio
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-4o

# ============================================
# Security Headers
# ============================================
CSP_ENABLED=True
HTTPS_REDIRECT=False

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_PER_MINUTE=60
