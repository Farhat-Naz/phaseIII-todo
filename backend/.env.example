# ============================================
# Todo App Backend Environment Variables
# Todo App Backend ماحولیاتی متغیرات
# ============================================
# Copy this file to .env and fill in your actual values
# اس فائل کو .env میں نقل کریں اور اپنی حقیقی اقدار بھریں

# ============================================
# Database Configuration | ڈیٹا بیس کی تشکیل
# ============================================

# Neon PostgreSQL connection string
# Get from Neon.tech | Neon.tech سے حاصل کریں
# Format: postgresql://user:password@host.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx-xxx.ap-south-1.aws.neon.tech/neondb?sslmode=require

# ============================================
# Application Settings
# ============================================

# Environment: development, staging, production
ENV=development

# Debug mode (True for development, False for production)
DEBUG=True

# API host and port
HOST=0.0.0.0
PORT=8000

# ============================================
# JWT Authentication | JWT توثیق
# ============================================

# Secret key for JWT token signing | JWT ٹوکن کے لیے خفیہ کلید
# Generate using: .\generate-secrets.ps1
# بنانے کے لیے: .\generate-secrets.ps1
SECRET_KEY=your-64-character-secret-key-here-generate-using-script

# Separate secret key for refresh tokens | ریفریش ٹوکن کے لیے الگ خفیہ کلید
# MUST be different from SECRET_KEY | SECRET_KEY سے مختلف ہونی چاہیے
REFRESH_TOKEN_SECRET=your-64-character-refresh-token-secret-different-from-above

# JWT algorithm
ALGORITHM=HS256

# Access token expiration time (in minutes)
# Recommended: 15-30 minutes for security
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token expiration time (in days)
# Recommended: 7-30 days for user experience
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# Email Configuration | ای میل کی تشکیل
# ============================================

# Email provider | ای میل فراہم کنندہ: "sendgrid" or "aws_ses"
EMAIL_PROVIDER=sendgrid

# SendGrid Configuration (if using SendGrid)
# Get API key from | سے حاصل کریں: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here

# AWS SES Configuration (if using AWS SES)
# Get credentials from AWS IAM: https://console.aws.amazon.com/iam/
AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SES_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Email sender configuration | بھیجنے والے کی تشکیل
# This email MUST be verified | یہ ای میل تصدیق شدہ ہونی چاہیے
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=TodoApp

# Frontend URL for email links | ای میل لنکس کے لیے Frontend URL
# Development | ترقی: http://localhost:3000
# Production | پیداوار: https://main.d1234567890.amplifyapp.com
FRONTEND_URL=http://localhost:3000

# ============================================
# CORS Settings | CORS کی ترتیبات
# ============================================

# Allowed origins for CORS (comma-separated) | CORS کے لیے اجازت شدہ origins
# Initially use * | ابتدائی طور پر * استعمال کریں
# After deployment, update with Amplify URL | تعیناتی کے بعد، Amplify URL کے ساتھ اپ ڈیٹ کریں
# Example | مثال: https://main.d1234567890.amplifyapp.com,http://localhost:3000
CORS_ORIGINS=*

# Allow credentials (cookies, authorization headers)
CORS_ALLOW_CREDENTIALS=True

# ============================================
# Security Headers
# ============================================

# Content Security Policy
CSP_ENABLED=True

# HTTPS redirect (True for production)
HTTPS_REDIRECT=False

# ============================================
# Logging
# ============================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: json, text
LOG_FORMAT=text

# ============================================
# Rate Limiting
# ============================================

# Requests per minute per IP
RATE_LIMIT_PER_MINUTE=60

# Login attempts per 15 minutes per IP
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW=900

# Registration attempts per hour per IP
REGISTER_RATE_LIMIT_ATTEMPTS=3
REGISTER_RATE_LIMIT_WINDOW=3600

# Password reset attempts per hour per email
PASSWORD_RESET_RATE_LIMIT_ATTEMPTS=3
PASSWORD_RESET_RATE_LIMIT_WINDOW=3600

# Email verification resend attempts per hour per user
EMAIL_VERIFICATION_RATE_LIMIT_ATTEMPTS=3
EMAIL_VERIFICATION_RATE_LIMIT_WINDOW=3600

# ============================================
# Testing
# ============================================

# Test database URL (optional, for integration tests)
TEST_DATABASE_URL=postgresql://user:password@localhost/test_db

# ============================================
# AI/LLM Configuration | AI/چیٹ بوٹ کی تشکیل (اختیاری)
# ============================================

# OpenAI API Key for GPT integration | GPT انضمام کے لیے OpenAI API کلید
# Get from | سے حاصل کریں: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# AI Model to use | استعمال کرنے والا AI ماڈل
# Options | اختیارات: gpt-4o, gpt-4-turbo, gpt-4, gpt-3.5-turbo
AI_MODEL=gpt-4o

# ============================================
# AWS DEPLOYMENT NOTES | AWS تعیناتی کے نوٹس
# ============================================

# For AWS Lambda deployment | AWS Lambda تعیناتی کے لیے:
# 1. Remove ENV, DEBUG, HOST, PORT (not needed) | ENV, DEBUG, HOST, PORT ہٹائیں
# 2. Keep only required variables as shown in serverless.yml | صرف ضروری متغیرات رکھیں
# 3. NEVER commit .env file to Git | .env فائل کبھی Git میں جمع نہ کریں

# Required for Lambda | Lambda کے لیے ضروری:
# - DATABASE_URL
# - SECRET_KEY
# - REFRESH_TOKEN_SECRET
# - CORS_ORIGINS
# - EMAIL_PROVIDER
# - SENDGRID_API_KEY or AWS SES credentials
# - EMAIL_FROM_ADDRESS
# - FRONTEND_URL
# - OPENAI_API_KEY (optional)

# ============================================
# HELPFUL COMMANDS | مفید کمانڈیں
# ============================================

# Generate secret keys | خفیہ کلیدیں بنائیں:
# .\generate-secrets.ps1

# Deploy to AWS | AWS پر تعینات کریں:
# serverless deploy

# View Lambda logs | Lambda لاگز دیکھیں:
# serverless logs -f api --tail

# Remove deployment | تعیناتی ہٹائیں:
# serverless remove
