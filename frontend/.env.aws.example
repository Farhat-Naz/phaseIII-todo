# ============================================
# Frontend Environment Variables for AWS Amplify
# ============================================
# Set these in AWS Amplify Console: App Settings > Environment Variables

# ============================================
# API Configuration
# ============================================

# Backend API URL (AWS Lambda API Gateway endpoint)
# Get this after deploying the backend Lambda function
# Format: https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/Prod
NEXT_PUBLIC_API_URL1=https://YOUR_API_GATEWAY_URL.execute-api.us-east-1.amazonaws.com/Prod

# ============================================
# Better Auth Configuration
# ============================================

# Secret key for Better Auth (MUST match backend SECRET_KEY)
# Generate with: openssl rand -hex 32
# IMPORTANT: Use the SAME secret key as your backend Lambda
BETTER_AUTH_SECRET=your-secret-key-here-generate-a-secure-random-string-min-32-chars

# Base URL where this Next.js app is hosted on AWS Amplify
# Get this from Amplify Console after deployment
# Format: https://main.dxxxxxxxxxx.amplifyapp.com
BETTER_AUTH_URL=https://YOUR_AMPLIFY_URL.amplifyapp.com

# ============================================
# Cookie Configuration (AWS Amplify)
# ============================================

# Cookie domain for authentication cookies
# For Amplify: .amplifyapp.com
# For custom domain: .yourdomain.com
NEXT_PUBLIC_COOKIE_DOMAIN=.amplifyapp.com

# Enable secure cookies (HTTPS only) - MUST be true for AWS
NEXT_PUBLIC_SECURE_COOKIES=true

# Cookie SameSite policy - Use "lax" for AWS cross-domain setup
NEXT_PUBLIC_COOKIE_SAMESITE=lax

# Cookie path (default: "/")
NEXT_PUBLIC_COOKIE_PATH=/

# Access token cookie name
NEXT_PUBLIC_ACCESS_TOKEN_COOKIE=access_token

# Refresh token cookie name
NEXT_PUBLIC_REFRESH_TOKEN_COOKIE=refresh_token

# ============================================
# Application Configuration
# ============================================

# Application name (displayed in UI)
NEXT_PUBLIC_APP_NAME=TodoApp

# Application URL (your Amplify URL or custom domain)
NEXT_PUBLIC_APP_URL=https://YOUR_AMPLIFY_URL.amplifyapp.com

# ============================================
# Optional Configuration
# ============================================

# Enable analytics (optional)
# NEXT_PUBLIC_ANALYTICS_ID=

# Sentry DSN for error tracking (optional)
# NEXT_PUBLIC_SENTRY_DSN=
