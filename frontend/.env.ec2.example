# ============================================
# Frontend Environment Variables for AWS EC2
# ============================================
# Copy this file to .env.production on your EC2 instance

# ============================================
# API Configuration
# ============================================
# Option 1: Direct connection (if not using Nginx proxy)
# Replace YOUR_EC2_PUBLIC_IP with actual IP (e.g., 3.110.123.45)
NEXT_PUBLIC_API_URL1=http://YOUR_EC2_PUBLIC_IP:8000

# Option 2: Using Nginx reverse proxy
# Uncomment this if you setup Nginx proxy (Step 8 in deployment guide)
# NEXT_PUBLIC_API_URL1=/api

# ============================================
# Application Configuration
# ============================================
NEXT_PUBLIC_APP_NAME=TodoApp
NEXT_PUBLIC_APP_URL=http://YOUR_EC2_PUBLIC_IP:3000
