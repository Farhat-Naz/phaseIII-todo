# Production Environment Variables for Vercel Deployment
# This file is used when building on Vercel

# API URL - Set this to your backend URL
# For local backend: http://localhost:8000
# For EC2 backend: http://YOUR_EC2_PUBLIC_IP:8000
# For Lambda backend: https://YOUR_API_GATEWAY_URL
NEXT_PUBLIC_API_URL=

# Application Configuration
NEXT_PUBLIC_APP_NAME=TodoApp
